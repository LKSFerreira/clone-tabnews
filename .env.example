# ==============================================================================
# AMBIENTE DE DESENVOLVIMENTO LOCAL (Docker / Localhost)
# ==============================================================================

# Variáveis do Banco de Dados PostgreSQL (utilizadas pela aplicação e pelo Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=local_user
POSTGRES_DB=local_db
POSTGRES_PASSWORD=local_password

# String de Conexão (Necessária para o `node-pg-migrate` / `npm run migrate:up`)
DATABASE_URL=postgres://local_user:local_password@localhost:5432/local_db

# Ambiente de Execução (development, test, production)
NODE_ENV=development

# ==============================================================================
# AMBIENTE EM NUVEM / PRODUÇÃO / EXTERNO (ex: Neon, AWS RDS, Aiven)
# Descomente e preencha caso vá conectar a um banco remoto
# ==============================================================================

# POSTGRES_HOST=ep-example-pooler.us-east-1.aws.neon.tech
# POSTGRES_PORT=5432
# POSTGRES_USER=neondb_owner
# POSTGRES_DB=neondb
# POSTGRES_PASSWORD=sua_senha_aqui
# DATABASE_URL=postgresql://neondb_owner:sua_senha_aqui@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require

# Parâmetros padrão libpq / psql (opcionais / fallback)
# PGHOST=ep-example-pooler.us-east-1.aws.neon.tech
# PGDATABASE=neondb
# PGUSER=neondb_owner
# PGPASSWORD=sua_senha_aqui
# PGPORT=5432
# PGSSLMODE=require
# PGCHANNELBINDING=require
